NEXT_PUBLIC_APP_URL=http://localhost:3000
BIND_HOST=0.0.0.0
PORT=3000
DATABASE_URL=mysql://user:password@host:3306/signal_kit?ssl={"rejectUnauthorized":true}

# Better Auth. The secret signs sessions and encrypts stored platform tokens:
# generate with `openssl rand -base64 48` and never change it without a rotation plan.
BETTER_AUTH_SECRET=replace-with-random-48-byte-secret
BETTER_AUTH_URL=http://localhost:3000

# OAuth apps. Callback URLs: ${BETTER_AUTH_URL}/api/auth/callback/{twitch|google|twitter}
TWITCH_CLIENT_ID=your-twitch-client-id
TWITCH_CLIENT_SECRET=your-twitch-client-secret
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# X OAuth 2.0 client (User authentication settings). X login is hidden until both are set.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Set to true once X approves Livestream API access; adds broadcast.read/write scopes.
X_LIVESTREAM_ENABLED=false

EVENTSUB_MANAGER_ENABLED=true
YOUTUBE_MANAGER_ENABLED=true
